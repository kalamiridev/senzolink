FUSIONSOLAR_USERNAME=
FUSIONSOLAR_PASSWORD=
# Use the prefix from your FusionSolar login URL.
# Example: https://region01eu5.fusionsolar.huawei.com -> region01eu5
FUSIONSOLAR_SUBDOMAIN=uni001eu5
FUSIONSOLAR_PLANT_ID=

# Optional override for a private registry image.
# FUSIONSOLAR_MQTT_IMAGE=senzolink/fusionsolar-mqtt:1.0.0

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC=fusionsolar/state

HA_DISCOVERY_ENABLED=true
HA_DISCOVERY_PREFIX=homeassistant
HA_DISCOVERY_NODE_ID=fusionsolar
HA_DEVICE_ID=

POLL_INTERVAL=60
