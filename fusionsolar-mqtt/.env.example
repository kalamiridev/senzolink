FUSIONSOLAR_USERNAME=
FUSIONSOLAR_PASSWORD=
# Use the prefix from your FusionSolar login URL.
# Example: https://region01eu5.fusionsolar.huawei.com -> region01eu5
FUSIONSOLAR_SUBDOMAIN=
# Optional. For accounts with multiple plants, set the exact plant name shown
# in FusionSolar. The bridge detects a single available plant automatically.
FUSIONSOLAR_PLANT_NAME=

# Hostname or IP address reachable from the container.
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOPIC=fusionsolar/state
# 0 = at most once, 1 = at least once, 2 = exactly once.
MQTT_QOS=0
# Optional broker authentication.
MQTT_USERNAME=
MQTT_PASSWORD=
# Enable for a TLS broker, commonly on port 8883.
MQTT_TLS_ENABLED=false

HA_DISCOVERY_ENABLED=true

POLL_INTERVAL=180
